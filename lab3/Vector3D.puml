  + operator!=(a, b : const Vector3D&) : bool
  + operator<<(out : ostream&, v : const Vector3D&) : ostream&
}

Friends ..> Vector3D : <<friend>>

note bottom of Friends
  + - * / реализованы через += -= *= /=
